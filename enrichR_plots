KEGG_dow <- read.table("./down_KEGG_2021_Human_table.txt",header = T,sep="\t")
bio_dow <- read.table("./down_GO_Biological_Process_2023_table.txt",header = T,sep="\t")
cc_dow <- read.table("./down_GO_Cellular_Component_2023_table.txt",header = T,sep="\t")
dow_mf <- read.table("./down_GO_Molecular_Function_2023_table.txt",header = T,sep="\t")


#### combined plot 

convert_overlap_to_count <- function(data) {
  data$Count <- as.numeric(sapply(strsplit(as.character(data$Overlap), "/"), `[`, 1))
  return(data)
}
KEGG_dow <- convert_overlap_to_count(KEGG_dow)
bio_dow <- convert_overlap_to_count(bio_dow)
cc_dow <- convert_overlap_to_count(cc_dow )
mf_dow <- convert_overlap_to_count(dow_mf)

library(ggplot2)
library(gridExtra)

plot_top10 <- function(data, title) {
  # Ensure the column names match your data
  data <- data[order(data$Adjusted.P.value), ]
  data_top10 <- head(data, 10)
  
  ggplot(data_top10, aes(x = -log10(Adjusted.P.value), y = reorder(Term, Adjusted.P.value))) +
    geom_point(aes(size = Count, color = -log10(Adjusted.P.value))) +
    scale_color_gradient(low = "blue", high = "red") +
    theme_minimal() +
    labs(
      x = "-log10(Adjusted P-value)",
      y = "Pathway",
      size = "Gene Count",
      color = "-log10(Adjusted P-value)",
      title = title
    ) +
    theme(axis.text.y = element_text(size = 10))
}

# Create individual plots
plot_KEGG_dow <- plot_top10(KEGG_dow, "KEGG_dow Pathways")
plot_bio_dow <- plot_top10(bio_dow, "bio_dow Pathways")
plot_cc_dow <- plot_top10(cc_dow , "cc_dow Pathways")
plot_mf_dow <- plot_top10(mf_dow, "mf_dow Pathways")


